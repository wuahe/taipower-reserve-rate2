PORT=3000
NODE_ENV=development

# Zeabur PostgreSQL usually injects POSTGRES_URI or POSTGRES_CONNECTION_STRING.
# DATABASE_URL is also supported. Leave all empty locally to use data/reserve-readings.json.
DATABASE_URL=
DATABASE_SSL=false

# Comma-separated official Taipower URLs. Defaults are set in src/config.ts.
TAIPOWER_SOURCE_URLS=

# Collector interval in milliseconds. 600000 = 10 minutes.
COLLECT_INTERVAL_MS=600000

# File storage path for local development when DATABASE_URL is empty.
DATA_FILE=data/reserve-readings.json

# Low reserve alerts: POST to the n8n notification hub webhook. Leave empty to disable.
NOTIFY_WEBHOOK_URL=
# Shared secret sent as the NOTIFY_TOKEN_HEADER header (n8n Header Auth credential).
NOTIFY_WEBHOOK_TOKEN=
NOTIFY_TOKEN_HEADER=X-Notify-Token
NOTIFY_THRESHOLD=10
NOTIFY_SEVERE_THRESHOLD=6
SITE_URL=https://taipower.albowu.com
